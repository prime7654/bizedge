DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=bizedge
POSTGRES_USER=bizedge
POSTGRES_PASSWORD=bizedge
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Comma-separated browser origins allowed to call the API (scheme + host, no
# trailing slash, no path). Overrides the defaults in settings; set the real
# frontend domain(s) here per environment.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
